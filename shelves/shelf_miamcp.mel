global proc shelf_miamcp () {
    global string $gBuffStr;
    global string $gBuffStr0;
    global string $gBuffStr1;


    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Start the Maya MCP bridge on localhost"
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "Start Maya MCP"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "mia_mcp_start_server_icon.png"
        -image1 "mia_mcp_start_server_icon.png"
        -style "iconOnly"
        -marginWidth 0
        -marginHeight 1
        -command "import maya.cmds as cmds\nif \"maya_mcp_plugin\" not in (cmds.pluginInfo(query=True, listPlugins=True) or []):\n    cmds.loadPlugin(\"maya_mcp_plugin.py\")\nimport mia_mcp_ui\nmia_mcp_ui.start_server()\n"
        -sourceType "python"
        -commandRepeatable 1
        -flat 1
    ;

}
